# Whisper-based transcription (debates:transcribe-phases command).
# WHISPER_BINARY_PATH: path to the Whisper CLI inside its Python venv — differs
# per host (home directory), do not assume the default matches every environment.
WHISPER_BINARY_PATH=/home/fawaz/whisper-venv/bin/whisper
# RECORDINGS_BASE_PATH: host filesystem path the egress container's /out is
# bind-mounted to (see LIVEKIT_EGRESS_OUTPUT_DIR) — used to resolve a
# debate_phases.audio_url like "/out/113/stage-1-30.mp3" into a real file path.
RECORDINGS_BASE_PATH=/var/recordings
